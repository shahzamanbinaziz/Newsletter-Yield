# Copy this file to ".env" and fill it in. NEVER upload ".env" to GitHub.

PORT=3000

# The public HTTPS address of this server. Every tracking link and unsubscribe link
# inside your emails points here, so it must be reachable from the internet.
BASE_URL=https://mail.yourcompany.com

# Long random text. Encrypts SMTP passwords and signs links. Create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-this-to-a-long-random-string

# Your dashboard login
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=choose-a-strong-password

# Only if the dashboard is hosted on GitHub Pages (comma separated), e.g. https://yourname.github.io
ALLOWED_ORIGIN=

DB_PATH=./data/mailhub.db
NODE_ENV=production
